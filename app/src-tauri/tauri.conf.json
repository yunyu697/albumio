{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "albumio",
  "version": "1.0.0-RC2",
  "identifier": "com.albumio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Albumio",
        "width": 1440,
        "height": 900,
        "minWidth": 432,
        "minHeight": 284,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5OEY0OTUxNjBBQTEwM0UKUldRK0VLcGdVVW1QZVpTbU0rYytDcktWYVU3UkZsekYyc01PRkxTbXdyQ2QvMlFJUEVwUjhKT3UK",
      "endpoints": [
        "https://github.com/yunyu697/albumio/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Photography",
    "shortDescription": "目录优先的图片浏览器",
    "longDescription": "Albumio 是目录优先的跨平台图片浏览器：删掉索引数据库也能正常浏览、看图、编辑与导出。",
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg",
          "jpe"
        ],
        "name": "JPEG image",
        "description": "JPEG image",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "image/jpeg"
      },
      {
        "ext": [
          "png"
        ],
        "name": "PNG image",
        "description": "PNG image",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "image/png"
      },
      {
        "ext": [
          "webp"
        ],
        "name": "WebP image",
        "description": "WebP image",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "image/webp"
      },
      {
        "ext": [
          "heic",
          "heif",
          "heics",
          "heifs"
        ],
        "name": "HEIF image",
        "description": "HEIF image",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "image/heic"
      },
      {
        "ext": [
          "tif",
          "tiff"
        ],
        "name": "TIFF image",
        "description": "TIFF image",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "image/tiff"
      },
      {
        "ext": [
          "bmp"
        ],
        "name": "BMP image",
        "description": "BMP image",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "image/bmp"
      },
      {
        "ext": [
          "gif"
        ],
        "name": "GIF image",
        "description": "GIF image",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "image/gif"
      },
      {
        "ext": [
          "avif"
        ],
        "name": "AVIF image",
        "description": "AVIF image",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "image/avif"
      }
    ],
    "windows": {
      "wix": {
        "version": "1.0.0.2"
      }
    }
  }
}
