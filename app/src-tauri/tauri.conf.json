{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "albumio",
  "version": "1.0.0-alpha1",
  "identifier": "com.albumio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Albumio",
        "width": 1440,
        "height": 900,
        "minWidth": 432,
        "minHeight": 284,
        "decorations": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc5OEY0OTUxNjBBQTEwM0UKUldRK0VLcGdVVW1QZVpTbU0rYytDcktWYVU3UkZsekYyc01PRkxTbXdyQ2QvMlFJUEVwUjhKT3UK",
      "endpoints": [
        "https://github.com/yunyu697/albumio/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "category": "Photography",
    "shortDescription": "目录优先的图片浏览器",
    "longDescription": "Albumio 是目录优先的跨平台图片浏览器：删掉索引数据库也能正常浏览、看图、编辑与导出。",
    "windows": {
      "wix": {
        "version": "1.0.0.1"
      }
    }
  }
}
